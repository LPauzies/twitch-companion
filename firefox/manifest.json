{
  "manifest_version": 3,
  "name": "Twitch Companion",
  "version": "4.0.0",
  "default_locale": "en",
  "description": "Quickly access your favorite Twitch streams, browse games, and receive live notifications. Fully customizable.",
  "browser_specific_settings": {
    "gecko": {
      "id": "{07e63f09-c95b-4e24-a0a0-30b0cc24827b}",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "common/icons/16.png",
    "32": "common/icons/32.png",
    "48": "common/icons/48.png",
    "64": "common/icons/64.png",
    "128": "common/icons/128.png"
  },
  "action": {
    "default_icon": {
      "16": "common/icons/16.png",
      "32": "common/icons/32.png",
      "48": "common/icons/48.png"
    },
    "default_popup": "common/html/popup.html",
    "default_title": "Twitch Companion"
  },
  "background": {
    "scripts": [
      "background-sw.js"
    ]
  },
  "content_scripts": [
    {
      "run_at": "document_start",
      "matches": [
        "https://*.twitch.tv/*"
      ],
      "all_frames": true,
      "js": [
        "common/content/theatre-mode.js"
      ]
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "alarms",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "https://api.twitch.tv/*",
    "https://id.twitch.tv/*",
    "https://*.twitch.tv/*",
    "https://static-cdn.jtvnw.net/*",
    "https://ndragomirov.github.io/*"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
