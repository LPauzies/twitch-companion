{
    "name": "twitch-companion",
    "version": "5.0.1",
    "description": "Manifest V3 Twitch companion extension for Chrome and Firefox",
    "engines": {
        "node": ">=22.0.0"
    },
    "dependencies": {
        "archiver": "^8.0.0",
        "backbone": "^1.6.1",
        "esbuild": "^0.28.2",
        "eslint": "^10.15.0",
        "express": "^5.3.0",
        "handlebars": "^4.7.10",
        "jquery": "^4.1.0",
        "semver": "^7.8.6",
        "underscore": "^1.13.8",
        "web-ext": "^10.8.0"
    },
    "scripts": {
        "dev": "node server.js",
        "start": "node server.js",
        "build": "node scripts/build.js --target=all",
        "build:all": "node scripts/build.js --target=all",
        "build:chrome": "node scripts/build.js --target=chrome",
        "build:firefox": "node scripts/build.js --target=firefox",
        "package:all": "node scripts/build.js --target=all --zip",
        "package:chrome": "node scripts/build.js --target=chrome --zip",
        "package:firefox": "node scripts/build.js --target=firefox --zip",
        "package:source": "node scripts/build.js --source-zip",
        "lint": "npx eslint common/lib/background-sw.js common/lib/bg-bridge.js common/lib/offscreen.js common/lib/utils.js common/lib/onerror.js common/lib/upload-sound.js common/content/theatre-mode.js scripts/*.js server.js",
        "lint:chrome": "node scripts/validate-chrome.js",
        "lint:firefox": "npx web-ext lint --source-dir ./build/firefox",
        "lint:all": "npm run lint && npm run lint:chrome && npm run lint:firefox",
        "bump:patch": "node scripts/bump-version.js patch",
        "bump:minor": "node scripts/bump-version.js minor",
        "bump:major": "node scripts/bump-version.js major",
        "publish:chrome": "node scripts/publish-chrome.js",
        "dev:firefox": "npx web-ext run --source-dir ./build/firefox",
        "clean": "node -e \"const fs=require('fs');fs.rmSync('build',{recursive:true,force:true});fs.rmSync('dist',{recursive:true,force:true});\""
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/LPauzies/twitch-companion"
    },
    "author": "lucas.pauzies@hotmail.fr",
    "license": "GPL-3.0-only",
    "bugs": {
        "url": "https://github.com/LPauzies/twitch-companion/issues"
    },
    "homepage": "https://github.com/LPauzies/twitch-companion"
}
